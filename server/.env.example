# Which LLM backend to use: "anthropic" (Claude, paid) or "ollama" (local, free)
LLM_PROVIDER=anthropic

# Required only when LLM_PROVIDER=anthropic — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Used only when LLM_PROVIDER=ollama (free local model via https://ollama.com)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional
PORT=3001
ENABLE_AGENT=false
# Cron syntax — default runs once every weekday morning at 8am
AGENT_SCHEDULE="0 8 * * 1-5"
# Where the agent posts its findings: "log" (default), or a webhook URL (Slack-compatible)
AGENT_WEBHOOK_URL=
# Set to "true" to let the agent autonomously create/update board items (tool-use loop)
AGENT_AUTONOMOUS=false
